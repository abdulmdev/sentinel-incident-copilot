{
  "realm": "sentinel",
  "enabled": true,
  "displayName": "Sentinel",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "tenant-admin",
        "description": "Manage the tenant's integrations (e.g. Alertmanager tokens)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sentinel-console",
      "name": "Sentinel console (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-console-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback",
        "http://localhost:13000/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:13000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login##http://localhost:13000/login"
      },
      "protocolMappers": [
        {
          "name": "sentinel-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sentinel-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sentinel-cli",
      "name": "Sentinel CLI (dev only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "sentinel-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sentinel-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant\", \"validations\": {\"pattern\": {\"pattern\": \"^[a-z0-9-]{1,63}$\", \"error-message\": \"invalid tenant\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "alice@acme",
      "enabled": true,
      "email": "alice@acme.example",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Acme",
      "attributes": {
        "tenant_id": [
          "acme"
        ]
      },
      "realmRoles": [
        "tenant-admin",
        "default-roles-sentinel"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice-dev-password",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob@acme",
      "enabled": true,
      "email": "bob@acme.example",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Acme",
      "attributes": {
        "tenant_id": [
          "acme"
        ]
      },
      "realmRoles": [
        "default-roles-sentinel"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "bob-dev-password",
          "temporary": false
        }
      ]
    },
    {
      "username": "carol@globex",
      "enabled": true,
      "email": "carol@globex.example",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Globex",
      "attributes": {
        "tenant_id": [
          "globex"
        ]
      },
      "realmRoles": [
        "tenant-admin",
        "default-roles-sentinel"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "carol-dev-password",
          "temporary": false
        }
      ]
    }
  ]
}
