{
  "name": "@sentinel-guard/sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK for Sentinel Guard: ask before acting, get a single-use capability once a human approves, redeem it once.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulmdev/sentinel-incident-copilot.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "ai-agents",
    "guardrails",
    "human-in-the-loop",
    "approvals",
    "mcp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  }
}
