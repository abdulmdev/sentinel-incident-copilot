flowchart LR
  U([user]) -->|OIDC code + PKCE| KC[(Keycloak / IdP)]
  KC -->|"RS256 access token<br/>tenant_id · roles · aud sentinel-api"| W[console BFF]
  W -->|user token| API["/api/v1/*"]
  AM([Alertmanager]) -->|"integration token (revocable)<br/>ES256 · aud sentinel-alerts"| ALR["/api/v1/alerts/**"]
  API --> GW[gateway<br/>service-token issuer<br/>ES256 key ring]
  ALR --> GW
  GW -->|"agent-call token, 60 s, per request"| AG[agent]
  GW -->|"tool token, 15 min"| AG
  GW -->|"reviewer's decision, as a delegate<br/>(its ServiceAccount token)"| SG[Sentinel Guard<br/>capability issuer<br/>its own ES256 key]
  AG -->|"proposal, then collects the capability<br/>(its ServiceAccount token)"| SG
  SG -->|"capability, once, expires with the approval"| AG
  AG -->|tool token| MCP["/mcp (gateway) · mcp-observability"]
  AG -->|capability| MR[remediation adapter]
  MR -->|redeem once| SG
  J[("gateway JWKS")] -. verify .-> AG & MCP
  GW --- J
  JG[("guard JWKS")] -. verify .-> MR
  SG --- JG
